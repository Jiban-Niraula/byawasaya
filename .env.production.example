# Copy to .env.production, chmod 600, and replace every value before use.
DOMAIN_NAME=example.com
POSTGRES_DB=byawasaya
DB_USERNAME=byawasaya_app
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
SUPERADMIN_BOOTSTRAP_ENABLED=false
SUPERADMIN_USERNAME=admin@example.com
SUPERADMIN_PASSWORD=REPLACE_WITH_ONE_TIME_STRONG_PASSWORD

# SMTP account with TLS enabled.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=no-reply@example.com

# Google OAuth credentials registered for https://DOMAIN_NAME/login/oauth2/code/google.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# S3-compatible private object storage with an HTTPS endpoint.
S3_ENDPOINT=https://s3.example.com
S3_REGION=ap-south-1
S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_S3_SECRET
S3_BUCKET=byawasaya-private
S3_PATH_STYLE=false
# Generate once and securely back up. Losing this key makes stored documents unreadable.
# openssl rand -base64 32
APP_STORAGE_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY
# Use a distinct key for merchant gateway credentials.
APP_PAYMENT_ENCRYPTION_KEY_BASE64=REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_KEY
# Separate key for platform MFA authenticator secrets; back it up and never rotate without a migration plan.
APP_PLATFORM_MFA_ENCRYPTION_KEY_BASE64=REPLACE_WITH_ANOTHER_BASE64_32_BYTE_KEY

# Must match the public app origin. Storefront and dashboard use same-origin requests.
CORS_ALLOWED_ORIGINS=https://example.com
AUTH_COOKIE_SAME_SITE=Lax

# Enable `--profile observability` only after setting these.
GRAFANA_ADMIN_USER=REPLACE_WITH_GRAFANA_ADMIN
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_SECRET

