# Copy this file to .env and replace every example secret before starting services.
DB_PASSWORD=replace_with_a_long_random_local_password
DB_URL=jdbc:postgresql://127.0.0.1:5433/byawasaya
DB_USERNAME=byawasaya
REDIS_HOST=localhost
REDIS_PORT=6379

# Required for platform administrator login. Use a strong unique password.
SUPERADMIN_BOOTSTRAP_ENABLED=true
SUPERADMIN_USERNAME=admin@byawasaya.local
SUPERADMIN_PASSWORD=replace_with_a_strong_unique_password
SUPERADMIN_PHONE=+9779800000000

# Meta WhatsApp Cloud API MFA delivery.
WHATSAPP_MFA_ENABLED=true
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=replace-with-meta-access-token
WHATSAPP_TEMPLATE_NAME=platform_login_otp
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Set true only behind HTTPS in production.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Development-only sample data. Keep false outside local evaluation.
DEMO_SEED=false

# Comma-separated frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=8080
CACHE_TTL=PT60S

# Email delivery. Local development uses the MailHog SMTP endpoint from docker-compose.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@byawasaya.local
EMAIL_MFA_ENABLED=true
EMAIL_MFA_FROM=no-reply@byawasaya.local
FRONTEND_URL=http://localhost:5173

# Google OAuth: replace both values with credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Private S3-compatible object storage (local MinIO by default).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=byawasaya-local
S3_SECRET_KEY=replace-with-a-long-minio-secret
S3_BUCKET=byawasaya-private
S3_PATH_STYLE=true
# Generate using: openssl rand -base64 32. Must decode to exactly 32 bytes.
APP_STORAGE_ENABLED=true
APP_STORAGE_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY
# Separate 32-byte key for platform MFA seeds. Keep it stable and backed up.
APP_PLATFORM_MFA_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY
